# Tile window to grid position
cmd_tile() {
    local usage="Usage: wctl tile <WINDOW> <position>
Valid positions:
  top-left, top-center, top-right
  left, center, right
  bottom-left, bottom-center, bottom-right"
    resolve_window_selector 1 "$usage" "$@"
    shift "$SEL_SHIFT"
    local id="$SEL_ID"
    local position="$1"

    local window
    window=$(get_window_json_by_id "$id")

    local wa_x wa_y wa_w wa_h
    read -r wa_x wa_y wa_w wa_h <<< "$(get_workarea_for_window_json "$window")"

    # Resolve the grid cell into pixel geometry (pure helper; dies on bad position).
    local geom
    geom=$(resolve_tile_geometry "$position" "$wa_x" "$wa_y" "$wa_w" "$wa_h") || exit 1
    local x y width height
    read -r x y width height <<< "$geom"

    local raw
    raw=$(dbus_call "MoveResize" "$id" "$x" "$y" "$width" "$height")
    report_result "$raw" "Window tiled to $position" "$id"
}

# Center window on screen
cmd_center() {
    resolve_window_selector 0 "Usage: wctl center <WINDOW> [horizontal|vertical|both]" "$@"
    shift "$SEL_SHIFT"
    local id="$SEL_ID"
    local axis="${1:-both}"

    # Normalize axis argument (support short forms)
    case "$axis" in
        h|horizontal)
            axis="horizontal"
            ;;
        v|vertical)
            axis="vertical"
            ;;
        both|"")
            axis="both"
            ;;
        *)
            die "Invalid axis: $axis. Must be 'horizontal', 'vertical', or 'both'"
            ;;
    esac
    
    local window
    window=$(get_window_json_by_id "$id")
    
    # Get current window geometry
    local win_x win_y win_w win_h
    win_x=$(echo "$window" | jq -r '.frame_rect.x')
    win_y=$(echo "$window" | jq -r '.frame_rect.y')
    win_w=$(echo "$window" | jq -r '.frame_rect.width')
    win_h=$(echo "$window" | jq -r '.frame_rect.height')
    
    local wa_x wa_y wa_w wa_h
    read -r wa_x wa_y wa_w wa_h <<< "$(get_workarea_for_window_json "$window")"

    # Centering is the workarea-relative 'center' token, so reuse the single
    # source of that formula in resolve_place_position (preserve size via Move).
    local new_x="$win_x"
    local new_y="$win_y"
    local success_msg

    if [[ "$axis" == "horizontal" || "$axis" == "both" ]]; then
        new_x=$(resolve_place_position center x "$wa_x" "$wa_w" "$win_w")
    fi

    if [[ "$axis" == "vertical" || "$axis" == "both" ]]; then
        new_y=$(resolve_place_position center y "$wa_y" "$wa_h" "$win_h")
    fi

    case "$axis" in
        horizontal) success_msg="Window centered horizontally" ;;
        vertical)   success_msg="Window centered vertically" ;;
        both)       success_msg="Window centered" ;;
    esac

    local raw
    raw=$(dbus_call "Move" "$id" "$new_x" "$new_y")
    report_result "$raw" "$success_msg" "$id"
}

# Place window using a mix of absolute pixels and workarea-relative tokens
cmd_place() {
    local usage="Usage: wctl place <WINDOW> <X> <Y> <WIDTH> <HEIGHT>
X:      number or left|center|right
Y:      number or top|center|bottom
WIDTH:  positive number or percentage like 50%
HEIGHT: positive number or percentage like 100%"
    resolve_window_selector 4 "$usage" "$@"
    shift "$SEL_SHIFT"
    local id="$SEL_ID"
    local x_token="$1"
    local y_token="$2"
    local width_token="$3"
    local height_token="$4"

    [[ $# -ne 4 ]] && die "$usage"

    local window
    window=$(get_window_json_by_id "$id")

    local wa_x wa_y wa_w wa_h
    read -r wa_x wa_y wa_w wa_h <<< "$(get_workarea_for_window_json "$window")"

    local width height x y
    width=$(resolve_place_size "$width_token" "$wa_w" "WIDTH")
    height=$(resolve_place_size "$height_token" "$wa_h" "HEIGHT")
    x=$(resolve_place_position "$x_token" "x" "$wa_x" "$wa_w" "$width")
    y=$(resolve_place_position "$y_token" "y" "$wa_y" "$wa_h" "$height")

    local raw
    raw=$(dbus_call "MoveResize" "$id" "$x" "$y" "$width" "$height")
    report_result "$raw" "Window placed" "$id"
}

