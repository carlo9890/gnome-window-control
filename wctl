                    ;;
                place)
                    _arguments "${_wctl_selector_opts[@]}" \
                        '1:window:_wctl_window_ids' \
                        '2:x position or keyword:(left center right)' \
                        '3:y position or keyword:(top center bottom)' \
                        '4:width or percentage:' \
                        '5:height or percentage:'
                    ;;
                tile)
                    _arguments "${_wctl_selector_opts[@]}" \
                        '1:window:_wctl_window_ids' \
                        '2:position:(top-left top-center top-right left center right bottom-left bottom-center bottom-right)'
                    ;;
                center)
                    _arguments "${_wctl_selector_opts[@]}" \
                        '1:window:_wctl_window_ids' \
                        '2:axis:(horizontal vertical both)'
                    ;;
                above|sticky)
                    _arguments "${_wctl_selector_opts[@]}" \
                        '1:window:_wctl_window_ids' \
                        '2:state:(on off)'
                    ;;
                completion)
                    _arguments '1:shell:(bash zsh)'
                    ;;
            esac
            ;;
    esac
}

_wctl "$@"
ZSH_COMPLETION
}

# Set sticky (all workspaces) state
cmd_sticky() {
    cmd_bool_state "SetSticky" \
        "Window set to all workspaces" \
        "Window removed from all workspaces" "$@"
}

# Main entry point
main() {
    # Handle no arguments
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi
    
    local cmd="$1"
    shift
    
    # Handle help, version, and completion commands (no D-Bus needed)
    case "$cmd" in
        help|--help|-h)
            show_help
            exit 0
            ;;
        version|--version|-v)
            echo "wctl $VERSION"
            exit 0
            ;;
        completion)
            local shell="${1:-}"
            case "$shell" in
                bash)
                    cmd_completion_bash
                    exit 0
                    ;;
                zsh)
                    cmd_completion_zsh
                    exit 0
                    ;;
                "")
                    die "Usage: wctl completion <bash|zsh>"
                    ;;
                *)
                    die "Unknown shell: $shell. Supported: bash, zsh"
                    ;;
            esac
            ;;
    esac
    
    case "$cmd" in
        # Listing commands
        list)
            cmd_list "$@"
            ;;
        focused)
            cmd_focused "$@"
            ;;
        workspaces)
            cmd_workspaces "$@"
            ;;
        monitors)
            cmd_monitors "$@"
            ;;
        
        # Info commands
        info)
            cmd_info "$@"
            ;;
        
        # Activation commands
        activate)
            cmd_activate "$@"
            ;;
        focus)
            cmd_focus "$@"
            ;;
        wait)
            cmd_wait "$@"
            ;;
        
        # Geometry commands
        move)
            cmd_move "$@"
            ;;
        resize)
            cmd_resize "$@"
            ;;
        move-resize)
            cmd_move_resize "$@"
            ;;
        
        # Tiling & Positioning commands
        place)
            cmd_place "$@"
            ;;
        tile)
            cmd_tile "$@"
            ;;
        center)
            cmd_center "$@"
            ;;

        # Workspace & monitor commands
        workspace)
            cmd_workspace "$@"
            ;;
        move-to-workspace)
            cmd_move_to_workspace "$@"
            ;;
        move-to-monitor)
            cmd_move_to_monitor "$@"
            ;;
        
        # State commands
        minimize)
            cmd_minimize "$@"
            ;;
        unminimize)
            cmd_unminimize "$@"
            ;;
        maximize)
            cmd_maximize "$@"
            ;;
        unmaximize)
            cmd_unmaximize "$@"
            ;;
        fullscreen)
            cmd_fullscreen "$@"
            ;;
        unfullscreen)
            cmd_unfullscreen "$@"
            ;;
        above)
            cmd_above "$@"
            ;;
        sticky)
            cmd_sticky "$@"
            ;;
        close)
            cmd_close "$@"
            ;;
        
        *)
            die "Unknown command: $cmd. Run 'wctl help' for usage."
            ;;
    esac
}

# Run the CLI only when executed directly (not when sourced, e.g. by unit tests)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
