# Shared helper for boolean window-state setters (above, sticky).
# Usage: cmd_bool_state <METHOD> <ON_MSG> <OFF_MSG> <ID> <STATE>
cmd_bool_state() {
    local method="$1"
    local on_msg="$2"
    local off_msg="$3"
    shift 3

    local name="${method#Set}"
    name="${name,,}"
    resolve_window_selector 1 "Usage: wctl ${name} <WINDOW> on|off" "$@"
    shift "$SEL_SHIFT"
    local id="$SEL_ID"
    local state="$1"

    local value
    case "$state" in
        on|true|1)
            value="true"
            ;;
        off|false|0)
            value="false"
            ;;
        *)
            die "State must be 'on' or 'off'"
            ;;
    esac

    local raw
    raw=$(dbus_call "$method" "$id" "$value")
    if [[ "$value" == "true" ]]; then
        report_result "$raw" "$on_msg" "$id"
    else
        report_result "$raw" "$off_msg" "$id"
    fi
}

