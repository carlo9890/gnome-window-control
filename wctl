# Move window
cmd_move() {
    resolve_window_selector 2 "Usage: wctl move <WINDOW> <X> <Y>" "$@"
    shift "$SEL_SHIFT"
    local id="$SEL_ID"
    local x="$1"
    local y="$2"

    [[ ! "$x" =~ ^-?[0-9]+$ ]] && die "X coordinate must be a number"
    [[ ! "$y" =~ ^-?[0-9]+$ ]] && die "Y coordinate must be a number"

    local raw
    raw=$(dbus_call "Move" "$id" "$x" "$y")
    report_result "$raw" "Window moved" "$id"
}

# Resize window
cmd_resize() {
    resolve_window_selector 2 "Usage: wctl resize <WINDOW> <WIDTH> <HEIGHT>" "$@"
    shift "$SEL_SHIFT"
    local id="$SEL_ID"
