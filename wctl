# Parse the single optional --json flag shared by workspaces / monitors.
# Usage: parse_json_flag "$@"   (prints true|false)
parse_json_flag() {
    local json_output=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json_output=true; shift ;;
            -*)     die "Unknown option: $1" ;;
            *)      die "Unexpected argument: $1" ;;
        esac
    done
    echo "$json_output"
}

# List workspaces in table format or as JSON
# Usage: cmd_workspaces [--json]
cmd_workspaces() {
    local json_output
    json_output=$(parse_json_flag "$@")

    local json
    json=$(dbus_call_json "ListWorkspaces")

    if [[ "$json_output" == true ]]; then
        echo "$json"
        return
    fi

    {
        echo -e "${BOLD}IDX\tNAME\tWINDOWS\tACTIVE${RESET}"
        echo "$json" | jq -r '.[] | [
            .index,
            (if .name == "" then "-" else .name end),
            .window_count,
            (if .is_active then "*" else "" end)
        ] | @tsv'
    } | column -t -s $'\t'
}

# Switch to a workspace
# Usage: cmd_workspace <N>
cmd_workspace() {
    local index="${1:-}"

    [[ -z "$index" ]] && die "Usage: wctl workspace <N>"
    [[ ! "$index" =~ ^[0-9]+$ ]] && die "Workspace index must be a number"

    local raw
    raw=$(dbus_call "ActivateWorkspace" "$index")
    report_result "$raw" "Switched to workspace $index" "$index" \
        "Cannot switch to workspace $index (does it exist? see wctl workspaces)"
}

# Move a window to a workspace
# Usage: cmd_move_to_workspace <WINDOW> <N>
cmd_move_to_workspace() {
    resolve_window_selector 1 "Usage: wctl move-to-workspace <WINDOW> <N>" "$@"
    shift "$SEL_SHIFT"
    local id="$SEL_ID"
    local index="$1"

    [[ ! "$index" =~ ^[0-9]+$ ]] && die "Workspace index must be a number"

    local raw
    raw=$(dbus_call "MoveToWorkspace" "$id" "$index")
    report_result "$raw" "Window moved to workspace $index" "$id" \
        "Window $id not found or workspace $index does not exist"
}

# List monitors in table format or as JSON
# Usage: cmd_monitors [--json]
cmd_monitors() {
    local json_output
    json_output=$(parse_json_flag "$@")

    local json
