#!/usr/bin/env bash
#
# wctl - Window Control CLI
# A wrapper for the GNOME Shell Window Control D-Bus extension
#

set -euo pipefail

# D-Bus service details
DBUS_DEST="org.gnome.Shell"
DBUS_PATH="/org/gnome/Shell/Extensions/WindowControl"
DBUS_IFACE="org.gnome.Shell.Extensions.WindowControl"

# Colors for output (disabled if not a tty)
if [[ -t 1 ]]; then
    BOLD='\033[1m'
    RED='\033[31m'
    RESET='\033[0m'
else
    BOLD=''
    RED=''
    RESET=''
fi

# Version
VERSION="0.8.0"

# Window selector state, set by resolve_window_selector (see WINDOW SELECTOR in
# the help text). SEL_JSON caches the ListDetailed reply when the resolver had
# to fetch it, so a command that needs the window's JSON does not fetch it twice.
SEL_KIND=""
SEL_VALUE=""
SEL_SHIFT=0
SEL_ID=""
SEL_JSON=""

# Optional gdbus call timeout in seconds (used by long-running calls like wait).
DBUS_CALL_TIMEOUT=""

# Print error message and exit
die() {
    echo -e "${RED}Error:${RESET} $1" >&2
    exit 1
}

# Validate that an argument is a numeric window ID (dies otherwise).
# Usage: validate_id <ID>
validate_id() {
    [[ ! "${1:-}" =~ ^[0-9]+$ ]] && die "Window ID must be a number"
    return 0
}

# Report the result of a boolean D-Bus action to the user.
# Usage: report_result <RAW_GVARIANT> <SUCCESS_MESSAGE> <ID> [<FAILURE_MESSAGE>]
# Prints the success message on "(true,)", otherwise prints the failure message
# (default: window not found, including the id) and exits non-zero.
report_result() {
    local raw="$1"
    local success_msg="$2"
    local id="${3:-}"
    local failure_msg="${4:-Window not found: $id}"

    if [[ "$raw" == "(true,)" ]]; then
        echo "$success_msg"
    else
        echo "$failure_msg"
        exit 1
    fi
}

# Extract the leading uint64 from a gdbus reply such as "(uint64 123,)" or
# "(uint64 123, 'title', 'class')". Pure string parsing; dies on anything else.
# Usage: parse_uint64_reply <RAW_GVARIANT>
parse_uint64_reply() {
    local raw="$1"

    if [[ "$raw" =~ ^\(uint64\ ([0-9]+)[,\)] ]]; then
        echo "${BASH_REMATCH[1]}"
    else
        die "Failed to parse D-Bus reply: $raw"
    fi
}

# Classify a failed D-Bus client invocation as "extension not running".
# Both transports (gdbus, busctl) funnel their error text through here so the
# same fault produces the same actionable hint regardless of which one ran.
# Usage: is_extension_not_running <ERROR_TEXT>
is_extension_not_running() {
    local err="$1"
    [[ "$err" == *"was not provided"* ]] && return 0
    [[ "$err" == *"does not exist"* ]] && return 0
    [[ "$err" == *"No route to host"* ]] && return 0
    [[ "$err" == *"ServiceUnknown"* ]] && return 0
    return 1
}

# Call D-Bus method and return raw output (GVariant format)
# Usage: dbus_call METHOD [ARGS...]
dbus_call() {
    local method="$1"
    shift

    local -a timeout_args=()
    [[ -n "$DBUS_CALL_TIMEOUT" ]] && timeout_args=(--timeout "$DBUS_CALL_TIMEOUT")

    local result
    if ! result=$(gdbus call --session \
        --dest "$DBUS_DEST" \
        --object-path "$DBUS_PATH" \
        --method "${DBUS_IFACE}.${method}" \
        "${timeout_args[@]}" \
        "$@" 2>&1); then

        if is_extension_not_running "$result"; then
            die "Window Control extension is not running. Enable it in GNOME Extensions."
        fi
        die "D-Bus call failed: $result"
    fi

    echo "$result"
}

# Call D-Bus method and return JSON output (using busctl)
# Usage: dbus_call_json METHOD
# Returns: JSON string from D-Bus string return value
dbus_call_json() {
    local method="$1"
    
    local result
    if ! result=$(busctl --user call --json=short \
        "$DBUS_DEST" \
        "$DBUS_PATH" \
        "$DBUS_IFACE" \
        "$method" 2>&1); then

        if is_extension_not_running "$result"; then
            die "Window Control extension is not running. Enable it in GNOME Extensions."
        fi
        die "D-Bus call failed: $result"
    fi
    
    # busctl --json returns: {"type":"s","data":["JSON_STRING"]}
    # Extract the actual JSON string from data[0]
    echo "$result" | jq -r '.data[0]'
}

# Get the ListDetailed JSON, reusing the copy the selector resolver fetched.
# Usage: get_windows_json
get_windows_json() {
    if [[ -z "$SEL_JSON" ]]; then
        SEL_JSON=$(dbus_call_json "ListDetailed")
    fi
    echo "$SEL_JSON"
}

# Get a single window from ListDetailed JSON
# Usage: get_window_json_by_id <ID>
get_window_json_by_id() {
    local id="${1:-}"

    validate_id "$id"

    local json window
    json=$(get_windows_json)
    window=$(echo "$json" | jq -ce --arg id "$id" '.[] | select(.id == ($id | tonumber))' 2>/dev/null) || {
        die "Window not found: $id"
    }

    echo "$window"
}

# Filter a ListDetailed JSON array. Empty filter values mean "no filter".
# A workspace filter keeps sticky windows, which are visible on every workspace.
# Pure jq, so it is unit-tested in tests/test-logic.sh.
# Usage: filter_windows_json <JSON> <WORKSPACE|""> <MONITOR|""> <CLASS|"">
filter_windows_json() {
    local json="$1"
    local workspace="${2:-}"
    local monitor="${3:-}"
    local wm_class="${4:-}"

    echo "$json" | jq -c --arg ws "$workspace" --arg mon "$monitor" --arg class "$wm_class" '
        map(select(
            ($ws == "" or .workspace_index == ($ws | tonumber) or .is_on_all_workspaces)
            and ($mon == "" or .monitor_index == ($mon | tonumber))
            and ($class == "" or .wm_class == $class)
        ))'
}

# Map a selector option to its kind name (shared by the resolver and wait).
# Usage: selector_kind_for_option -c|-t|-s|-p
selector_kind_for_option() {
    case "$1" in
        -c) echo "class" ;;
        -t) echo "title" ;;
        -s) echo "substring" ;;
        -p) echo "pid" ;;
        *)  die "Unknown selector option: $1" ;;
    esac
}

# Parse the window selector at the front of the argument list into
# SEL_KIND (id|focused|class|title|substring|pid), SEL_VALUE and SEL_SHIFT (the
# number of arguments the selector occupied). Pure; dies on invalid input.
# Usage: parse_window_selector "$@"
parse_window_selector() {
    SEL_KIND=""
    SEL_VALUE=""
    SEL_SHIFT=0
    local arg="${1:-}"

    case "$arg" in
        focused)
            SEL_KIND="focused"
            SEL_SHIFT=1
            ;;
        -c|-t|-s|-p)
            [[ $# -lt 2 ]] && die "Option $arg requires an argument"
            SEL_KIND=$(selector_kind_for_option "$arg")
            SEL_VALUE="$2"
            SEL_SHIFT=2
            [[ "$SEL_KIND" == "pid" && ! "$SEL_VALUE" =~ ^[0-9]+$ ]] && die "PID must be a number"
            ;;
        -*)
            die "Unknown option: $arg"
            ;;
        *)
            validate_id "$arg"
            SEL_KIND="id"
            SEL_VALUE="$arg"
            SEL_SHIFT=1
            ;;
    esac
    return 0
}

# Pick the single window matching <KIND> <VALUE> from ListDetailed JSON and
# print its id. Dies when no window matches, and when more than one does (the
# candidates are listed so the caller can pick an id). Pure jq.
# Usage: select_window_id_from_json <JSON> <KIND> <VALUE>
select_window_id_from_json() {
    local json="$1"
    local kind="$2"
    local value="$3"

    local filter
    case "$kind" in
        class)     filter='.wm_class == $v' ;;
        title)     filter='.title == $v' ;;
        substring) filter='(.title | contains($v))' ;;
        pid)       filter='.pid == ($v | tonumber)' ;;
        *)         die "Unknown selector kind: $kind" ;;
    esac

    local matches
    matches=$(echo "$json" | jq -r --arg v "$value" \
        "[.[] | select($filter)] | .[] | [.id, .wm_class, .title] | @tsv")

    if [[ -z "$matches" ]]; then
        die "No window matches $kind '$value'"
    fi

    local count
    count=$(echo "$matches" | wc -l)
    if (( count > 1 )); then
        die "$kind '$value' matches $count windows; use an ID:
$(echo "$matches" | column -t -s $'\t')"
    fi

    echo "${matches%%$'\t'*}"
}

# Resolve the selector at the front of the argument list to a window ID in
# SEL_ID (SEL_SHIFT tells the caller how many arguments to drop). Dies with
# <USAGE> when the selector is missing or fewer than <MIN_AFTER> arguments
# follow it, before any D-Bus call, so argument errors never need the extension.
# A numeric ID needs no D-Bus call; "focused" costs one GetFocused call; the
# match options cost one ListDetailed call, cached in SEL_JSON for the command
# that follows.
# Usage: resolve_window_selector <MIN_AFTER> <USAGE> "$@"
resolve_window_selector() {
    local min_after="$1"
    local usage="$2"
    shift 2

    [[ $# -eq 0 ]] && die "$usage"
    parse_window_selector "$@"
    (( $# - SEL_SHIFT < min_after )) && die "$usage"

    case "$SEL_KIND" in
        id)
            SEL_ID="$SEL_VALUE"
            ;;
        focused)
            local raw
            raw=$(dbus_call "GetFocused")
            SEL_ID=$(parse_uint64_reply "$raw")
            [[ "$SEL_ID" == "0" ]] && die "No window focused"
            ;;
        *)
            local json
            json=$(get_windows_json)
            SEL_ID=$(select_window_id_from_json "$json" "$SEL_KIND" "$SEL_VALUE") || exit 1
            ;;
    esac
    return 0
}

# Parse a GetWorkarea response into shell-friendly values
# Usage: parse_workarea_rect "(x, y, width, height)"
parse_workarea_rect() {
    local raw="$1"

    if [[ "$raw" =~ ^\((-?[0-9]+),\ (-?[0-9]+),\ ([0-9]+),\ ([0-9]+)\)$ ]]; then
        echo "${BASH_REMATCH[1]} ${BASH_REMATCH[2]} ${BASH_REMATCH[3]} ${BASH_REMATCH[4]}"
    else
        die "Failed to parse workarea: $raw"
    fi
}

# Get workarea for a monitor
# Usage: get_workarea_by_monitor <MONITOR_INDEX>
get_workarea_by_monitor() {
    local monitor_index="$1"
    local raw

    raw=$(dbus_call "GetWorkarea" "$monitor_index")
    parse_workarea_rect "$raw"
}

# Get workarea for a window JSON object from ListDetailed
# Usage: get_workarea_for_window_json <WINDOW_JSON>
get_workarea_for_window_json() {
    local window="$1"
    local monitor_index

    monitor_index=$(echo "$window" | jq -r '.monitor_index')
    get_workarea_by_monitor "$monitor_index"
}

# Resolve WIDTH/HEIGHT token for place command
# Usage: resolve_place_size <TOKEN> <WORKAREA_SIZE> <LABEL>
resolve_place_size() {
    local token="$1"
    local base_size="$2"
    local label="$3"
    local value

    if [[ "$token" =~ ^[1-9][0-9]*$ ]]; then
        echo "$token"
        return
    fi

    if [[ "$token" =~ ^([0-9]+)%$ ]]; then
        value=$((base_size * BASH_REMATCH[1] / 100))
        (( value > 0 )) || die "${label} percentage resolves to 0 pixels: $token"
        echo "$value"
        return
    fi

    die "Invalid ${label}: $token. Use a positive number or percentage like 50%"
}

# Resolve X/Y token for place command
# Usage: resolve_place_position <TOKEN> <x|y> <WORKAREA_POS> <WORKAREA_SIZE> <WINDOW_SIZE>
resolve_place_position() {
    local token="$1"
    local axis="$2"
    local workarea_pos="$3"
    local workarea_size="$4"
    local window_size="$5"

    if [[ "$token" =~ ^-?[0-9]+$ ]]; then
        echo "$token"
        return
    fi

    case "$axis:$token" in
        x:left)
            echo "$workarea_pos"
            ;;
        x:center)
            echo $((workarea_pos + (workarea_size - window_size) / 2))
            ;;
        x:right)
            echo $((workarea_pos + workarea_size - window_size))
            ;;
        y:top)
            echo "$workarea_pos"
            ;;
        y:center)
            echo $((workarea_pos + (workarea_size - window_size) / 2))
            ;;
        y:bottom)
            echo $((workarea_pos + workarea_size - window_size))
            ;;
        x:*)
            die "Invalid X position: $token. Use a number or left|center|right"
            ;;
        y:*)
            die "Invalid Y position: $token. Use a number or top|center|bottom"
            ;;
    esac
}

# Resolve a 4x2 grid tile position into "x y width height" for a given workarea.
# Pure arithmetic (no D-Bus), so it is unit-tested directly in tests/test-logic.sh.
# Usage: resolve_tile_geometry <POSITION> <WA_X> <WA_Y> <WA_W> <WA_H>
resolve_tile_geometry() {
    local position="$1"
    local wa_x="$2"
    local wa_y="$3"
    local wa_w="$4"
    local wa_h="$5"

    local cell_w=$((wa_w / 4))
    local cell_h=$((wa_h / 2))

    local start_col end_col start_row end_row
    case "$position" in
        top-left)      start_col=0 end_col=0 start_row=0 end_row=0 ;;
        top-center)    start_col=1 end_col=2 start_row=0 end_row=0 ;;
        top-right)     start_col=3 end_col=3 start_row=0 end_row=0 ;;
        left)          start_col=0 end_col=0 start_row=0 end_row=1 ;;
        center)        start_col=1 end_col=2 start_row=0 end_row=1 ;;
        right)         start_col=3 end_col=3 start_row=0 end_row=1 ;;
        bottom-left)   start_col=0 end_col=0 start_row=1 end_row=1 ;;
        bottom-center) start_col=1 end_col=2 start_row=1 end_row=1 ;;
        bottom-right)  start_col=3 end_col=3 start_row=1 end_row=1 ;;
        *)
            die "Invalid position: $position
Valid positions:
  top-left, top-center, top-right
  left, center, right
  bottom-left, bottom-center, bottom-right"
            ;;
    esac

    local x=$((wa_x + cell_w * start_col))
    local y=$((wa_y + cell_h * start_row))
    local width=$((cell_w * (end_col - start_col + 1)))
    local height=$((cell_h * (end_row - start_row + 1)))
    echo "$x $y $width $height"
}

