#!/usr/bin/env bash
#
# wctl - Window Control CLI
# A wrapper for the GNOME Shell Window Control D-Bus extension
#

set -euo pipefail

# D-Bus service details
DBUS_DEST="org.gnome.Shell"
DBUS_PATH="/org/gnome/Shell/Extensions/WindowControl"
DBUS_IFACE="org.gnome.Shell.Extensions.WindowControl"

# Colors for output (disabled if not a tty)
if [[ -t 1 ]]; then
    BOLD='\033[1m'
    RED='\033[31m'
    RESET='\033[0m'
else
    BOLD=''
    RED=''
    RESET=''
fi

# Version
VERSION="0.7.0"

# Print error message and exit
die() {
    echo -e "${RED}Error:${RESET} $1" >&2
    exit 1
}

# Validate that an argument is a numeric window ID (dies otherwise).
# Usage: validate_id <ID>
validate_id() {
    [[ ! "${1:-}" =~ ^[0-9]+$ ]] && die "Window ID must be a number"
    return 0
}

# Report the result of a boolean D-Bus action to the user.
# Usage: report_result <RAW_GVARIANT> <SUCCESS_MESSAGE> <ID>
# Prints the success message on "(true,)", otherwise reports the window as not
# found (including the id) and exits non-zero.
report_result() {
    local raw="$1"
    local success_msg="$2"
    local id="${3:-}"

    if [[ "$raw" == "(true,)" ]]; then
        echo "$success_msg"
    else
        echo "Window not found: $id"
        exit 1
    fi
}

# Classify a failed D-Bus client invocation as "extension not running".
# Both transports (gdbus, busctl) funnel their error text through here so the
# same fault produces the same actionable hint regardless of which one ran.
# Usage: is_extension_not_running <ERROR_TEXT>
is_extension_not_running() {
    local err="$1"
    [[ "$err" == *"was not provided"* ]] && return 0
    [[ "$err" == *"does not exist"* ]] && return 0
    [[ "$err" == *"No route to host"* ]] && return 0
    [[ "$err" == *"ServiceUnknown"* ]] && return 0
    return 1
}

# Call D-Bus method and return raw output (GVariant format)
# Usage: dbus_call METHOD [ARGS...]
dbus_call() {
    local method="$1"
    shift

    local result
    if ! result=$(gdbus call --session \
        --dest "$DBUS_DEST" \
        --object-path "$DBUS_PATH" \
        --method "${DBUS_IFACE}.${method}" \
        "$@" 2>&1); then

        if is_extension_not_running "$result"; then
            die "Window Control extension is not running. Enable it in GNOME Extensions."
        fi
        die "D-Bus call failed: $result"
    fi

    echo "$result"
}

# Call D-Bus method and return JSON output (using busctl)
# Usage: dbus_call_json METHOD
# Returns: JSON string from D-Bus string return value
dbus_call_json() {
    local method="$1"
    
    local result
    if ! result=$(busctl --user call --json=short \
        "$DBUS_DEST" \
        "$DBUS_PATH" \
        "$DBUS_IFACE" \
        "$method" 2>&1); then

        if is_extension_not_running "$result"; then
            die "Window Control extension is not running. Enable it in GNOME Extensions."
        fi
        die "D-Bus call failed: $result"
    fi
    
    # busctl --json returns: {"type":"s","data":["JSON_STRING"]}
    # Extract the actual JSON string from data[0]
    echo "$result" | jq -r '.data[0]'
}

# Get a single window from ListDetailed JSON
# Usage: get_window_json_by_id <ID>
get_window_json_by_id() {
    local id="${1:-}"

    validate_id "$id"

    local json window
    json=$(dbus_call_json "ListDetailed")
    window=$(echo "$json" | jq -ce --arg id "$id" '.[] | select(.id == ($id | tonumber))' 2>/dev/null) || {
        die "Window not found: $id"
    }

    echo "$window"
}

# Parse a GetWorkarea response into shell-friendly values
# Usage: parse_workarea_rect "(x, y, width, height)"
parse_workarea_rect() {
    local raw="$1"

    if [[ "$raw" =~ ^\((-?[0-9]+),\ (-?[0-9]+),\ ([0-9]+),\ ([0-9]+)\)$ ]]; then
        echo "${BASH_REMATCH[1]} ${BASH_REMATCH[2]} ${BASH_REMATCH[3]} ${BASH_REMATCH[4]}"
    else
        die "Failed to parse workarea: $raw"
    fi
}

# Get workarea for a monitor
# Usage: get_workarea_by_monitor <MONITOR_INDEX>
get_workarea_by_monitor() {
    local monitor_index="$1"
    local raw

    raw=$(dbus_call "GetWorkarea" "$monitor_index")
    parse_workarea_rect "$raw"
}

# Get workarea for a window JSON object from ListDetailed
# Usage: get_workarea_for_window_json <WINDOW_JSON>
get_workarea_for_window_json() {
    local window="$1"
    local monitor_index

    monitor_index=$(echo "$window" | jq -r '.monitor_index')
    get_workarea_by_monitor "$monitor_index"
}

# Resolve WIDTH/HEIGHT token for place command
# Usage: resolve_place_size <TOKEN> <WORKAREA_SIZE> <LABEL>
resolve_place_size() {
    local token="$1"
    local base_size="$2"
    local label="$3"
    local value

    if [[ "$token" =~ ^[1-9][0-9]*$ ]]; then
        echo "$token"
        return
    fi

    if [[ "$token" =~ ^([0-9]+)%$ ]]; then
        value=$((base_size * BASH_REMATCH[1] / 100))
        (( value > 0 )) || die "${label} percentage resolves to 0 pixels: $token"
        echo "$value"
        return
    fi

    die "Invalid ${label}: $token. Use a positive number or percentage like 50%"
}

# Resolve X/Y token for place command
# Usage: resolve_place_position <TOKEN> <x|y> <WORKAREA_POS> <WORKAREA_SIZE> <WINDOW_SIZE>
resolve_place_position() {
    local token="$1"
    local axis="$2"
    local workarea_pos="$3"
    local workarea_size="$4"
    local window_size="$5"

    if [[ "$token" =~ ^-?[0-9]+$ ]]; then
        echo "$token"
        return
    fi

    case "$axis:$token" in
        x:left)
            echo "$workarea_pos"
            ;;
        x:center)
            echo $((workarea_pos + (workarea_size - window_size) / 2))
            ;;
        x:right)
            echo $((workarea_pos + workarea_size - window_size))
            ;;
        y:top)
            echo "$workarea_pos"
            ;;
        y:center)
            echo $((workarea_pos + (workarea_size - window_size) / 2))
            ;;
        y:bottom)
            echo $((workarea_pos + workarea_size - window_size))
            ;;
        x:*)
            die "Invalid X position: $token. Use a number or left|center|right"
            ;;
        y:*)
            die "Invalid Y position: $token. Use a number or top|center|bottom"
            ;;
    esac
}

# Resolve a 4x2 grid tile position into "x y width height" for a given workarea.
# Pure arithmetic (no D-Bus), so it is unit-tested directly in tests/test-logic.sh.
# Usage: resolve_tile_geometry <POSITION> <WA_X> <WA_Y> <WA_W> <WA_H>
resolve_tile_geometry() {
    local position="$1"
    local wa_x="$2"
    local wa_y="$3"
    local wa_w="$4"
    local wa_h="$5"

    local cell_w=$((wa_w / 4))
    local cell_h=$((wa_h / 2))

    local start_col end_col start_row end_row
    case "$position" in
        top-left)      start_col=0 end_col=0 start_row=0 end_row=0 ;;
        top-center)    start_col=1 end_col=2 start_row=0 end_row=0 ;;
        top-right)     start_col=3 end_col=3 start_row=0 end_row=0 ;;
        left)          start_col=0 end_col=0 start_row=0 end_row=1 ;;
        center)        start_col=1 end_col=2 start_row=0 end_row=1 ;;
        right)         start_col=3 end_col=3 start_row=0 end_row=1 ;;
        bottom-left)   start_col=0 end_col=0 start_row=1 end_row=1 ;;
        bottom-center) start_col=1 end_col=2 start_row=1 end_row=1 ;;
        bottom-right)  start_col=3 end_col=3 start_row=1 end_row=1 ;;
        *)
            die "Invalid position: $position
Valid positions:
  top-left, top-center, top-right
  left, center, right
  bottom-left, bottom-center, bottom-right"
            ;;
    esac

    local x=$((wa_x + cell_w * start_col))
    local y=$((wa_y + cell_h * start_row))
    local width=$((cell_w * (end_col - start_col + 1)))
    local height=$((cell_h * (end_row - start_row + 1)))
    echo "$x $y $width $height"
}

