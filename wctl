# Helper for simple window state commands
# Usage: cmd_simple_state METHOD MESSAGE_SUCCESS
cmd_simple_state() {
    local method="$1"
    local success_msg="$2"
    local id="${3:-}"

    [[ -z "$id" ]] && die "Usage: wctl ${method,,} <ID>"
    validate_id "$id"

    local raw
    raw=$(dbus_call "$method" "$id")
    report_result "$raw" "$success_msg" "$id"
}

